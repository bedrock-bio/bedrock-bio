{
	"name": "bedrock-bio-mcp",
	"main": "src/index.ts",
	"compatibility_date": "2025-04-01",
	"compatibility_flags": ["nodejs_compat"],
	"workers_dev": false,
	"preview_urls": false,
	"observability": { "enabled": true },
	"r2_buckets": [
		{
			"binding": "CATALOG_BUCKET",
			"bucket_name": "bedrock-bio-datasets"
		}
	],
	"durable_objects": {
		"bindings": [
			{
				"name": "MCP_OBJECT",
				"class_name": "BedrockBioMcpServer"
			}
		]
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": ["BedrockBioMcpServer"]
		}
	],
	"env": {
		"dev": {
			"name": "bedrock-bio-mcp-dev",
			"observability": { "enabled": true },
			"r2_buckets": [
				{
					"binding": "CATALOG_BUCKET",
					"bucket_name": "bedrock-bio-datasets"
				}
			],
			"durable_objects": {
				"bindings": [
					{
						"name": "MCP_OBJECT",
						"class_name": "BedrockBioMcpServer"
					}
				]
			},
			"migrations": [
				{
					"tag": "v1",
					"new_sqlite_classes": ["BedrockBioMcpServer"]
				}
			]
		}
	}
}